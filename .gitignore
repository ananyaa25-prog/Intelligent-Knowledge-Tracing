# Python / env
__pycache__/
*.pyc
.venv/
.pytest_cache/
# Node
server/node_modules/
# Large / immutable data (never modified by this project; kept out of git)
data/raw/
data/processed/*.pkl
data/processed/*.pt
# ...except the small trained models and graph the app needs (about 3.2 MB in total)
!data/processed/best_*.pt
!data/processed/skill_graph.pkl
data/processed/kt_sessions.db*
data/processed/session_logs.jsonl
data/backups/
# temp
_tmp*/
reports/screenshots/*.tmp
.tools/
# v3 outputs (large / regenerable)
models_v3/*.pt
data/processed_v3/*
!data/processed_v3/.gitkeep
data/external/*
!data/external/.gitkeep
!data/external/README.md
